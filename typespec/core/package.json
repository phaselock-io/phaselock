{
  "name": "@phaselock/typespec-core",
  "version": "0.2.0",
  "description": "PhaseLock data-model vocabulary for TypeSpec: stores, key templates, engines",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "exports": {
      ".": {
        "typespec": "./lib/dist.tsp",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "typespec": "./lib/src.tsp",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "rm -rf dist && pnpm run build"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.0.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib/main.tsp",
    "lib/dist.tsp",
    "dist/**"
  ]
}
