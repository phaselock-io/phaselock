{
  "name": "@phaselock/typespec-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm --filter @phaselock/typespec-tests gen && pnpm --filter @phaselock/typespec-tests test",
    "check": "pnpm check:tsc && pnpm check:lint && pnpm check:fmt",
    "check:tsc": "pnpm -r build && tsc -p tests",
    "check:lint": "eslint .",
    "check:fmt": "prettier --check \"**/*.ts\"",
    "fmt": "prettier --write \"**/*.ts\" && eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitest/eslint-plugin": "^1.1.31",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.1.1",
    "eslint-plugin-import": "^2.31.0",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3"
  }
}
