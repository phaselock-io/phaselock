{
  "name": "@phaselock/plugins",
  "version": "0.2.0",
  "description": "PhaseLock's plugins: side effects and schedules for a PhaseLock database",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit && prettier --check \"src/**/*.ts\"",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "prepack": "rm -rf dist && pnpm run build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**",
    "LICENSE"
  ]
}
