{
  "name": "@phaselock/client",
  "version": "0.2.0",
  "description": "PhaseLock client library for JS-native hosts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p tsconfig.test.json --noEmit && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepack": "rm -rf dist && pnpm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE"
  ]
}
